# ==============================
# Python
# ==============================
# Compiled bytecode
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Packaging artefacts
build/
dist/
*.egg-info/

# ==============================
# Secrets and environment variables
# ==============================
# Real credentials never go in Git
.env
.env.*
!.env.example

# Real Kubernetes Secret manifests
k8s/*secret*.yaml
!k8s/*secret.example.yaml

# Cluster admin credentials
kubeconfig
*.kubeconfig
admin.conf

# SSH keys for your EC2 instances
*.pem
*.key

# ==============================
# Docker
# ==============================

docker-compose.override.yml
compose.override.yaml

# ==============================
# Editors and operating systems
# ==============================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ==============================
# Logs and load-test output
# ==============================
*.log
loadtest-results/